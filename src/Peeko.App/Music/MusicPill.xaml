<!-- Isi pil musik: cover 20 px (r 6) dan lima bar 3 px, dirapatkan di tengah pil 200 × 32
     dengan jarak 10 px seperti jarak kedua mata Kedip (revisi #12; desain aslinya cover di kiri,
     bar di kanan pil 260 px). -->
<UserControl x:Class="Peeko.App.Music.MusicPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Peeko.App.Controls"
             xmlns:local="clr-namespace:Peeko.App.Music"
             Height="32" IsHitTestVisible="False">

    <StackPanel x:Name="Root" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="CoverBox" Width="20" Height="20"
                CornerRadius="{StaticResource Peeko.Radius.Sm}" Background="{StaticResource Peeko.Brush.SurfaceRaised}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border CornerRadius="{StaticResource Peeko.Radius.Sm}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Border>

        <!-- Pin lirik: baris yang sedang diputar. Lebar pil mengikuti teks (NotchWindow). -->
        <TextBlock x:Name="LyricText" Margin="10,0,0,0" MaxWidth="{x:Static local:MusicPill.MaxLyricWidth}" VerticalAlignment="Center"
                   Style="{StaticResource Peeko.Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Peeko.Brush.TextPrimary}"
                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

        <!-- Lebar tetap supaya posisi cover tidak bergeser saat bar naik-turun. -->
        <controls:Visualizer x:Name="Bars" Margin="10,0,0,0" BarCount="5" BarWidth="3" BarGap="2" MaxBarHeight="14"
                             BarBrush="{Binding AccentBrush}" />
    </StackPanel>
</UserControl>
