<!-- Isi pil musik: cover 20 px (r 6) dan empat bar 3 px, dirapatkan di tengah pil 200 × 32
     dengan jarak 10 px seperti jarak kedua mata Kedip (revisi #12; desain aslinya cover di kiri,
     bar di kanan pil 260 px). -->
<UserControl x:Class="Peeko.App.Music.MusicPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" IsHitTestVisible="False">
    <UserControl.Resources>
        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{Binding AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource Peeko.Brush.TextTertiary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Root" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="CoverBox" Width="20" Height="20"
                CornerRadius="{StaticResource Peeko.Radius.Sm}" Background="{StaticResource Peeko.Brush.SurfaceRaised}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border CornerRadius="{StaticResource Peeko.Radius.Sm}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Border>

        <!-- Lebar tetap 18 px supaya posisi cover tidak bergeser saat bar naik-turun. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Width="18">
            <Rectangle x:Name="Bar0" Style="{StaticResource Bar}" Margin="0" />
            <Rectangle x:Name="Bar1" Style="{StaticResource Bar}" />
            <Rectangle x:Name="Bar2" Style="{StaticResource Bar}" />
            <Rectangle x:Name="Bar3" Style="{StaticResource Bar}" />
        </StackPanel>
    </StackPanel>
</UserControl>
