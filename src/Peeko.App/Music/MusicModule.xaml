<!-- Modul Musik ringkas 400 × 88 (0.3.0): cover 64, info, kontrol 32 · 40 · 32, lalu baris progress. -->
<UserControl x:Class="Peeko.App.Music.MusicModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Peeko.App.Controls">
    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="Vis" />

        <Geometry x:Key="IconPrev">M18,6 V18 L9,12 Z M5,6 H7.2 V18 H5 Z</Geometry>
        <Geometry x:Key="IconNext">M6,6 V18 L15,12 Z M16.8,6 H19 V18 H16.8 Z</Geometry>
        <Geometry x:Key="IconPlay">M8,5.5 V18.5 L19,12 Z</Geometry>
        <Geometry x:Key="IconPause">M6.5,5 H10.5 V19 H6.5 Z M13.5,5 H17.5 V19 H13.5 Z</Geometry>
        <Geometry x:Key="IconChevronLeft">M14.5,6 L8.5,12 L14.5,18</Geometry>
        <Geometry x:Key="IconChevronRight">M9.5,6 L15.5,12 L9.5,18</Geometry>

        <!-- Panah kecil 22 × 22 di samping chip sumber. -->
        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Background="Transparent">
                            <Path Style="{StaticResource Peeko.IconPath}" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.LayoutTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Path.LayoutTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol ikon 32 × 32, radius 10. Pressed: scale 0.94 (Components.dc.html). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="{StaticResource Peeko.Radius.Md}" Background="Transparent">
                            <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"
                                  Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.LayoutTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </Path.LayoutTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextDisabled}" />
                                <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol utama 40 × 40 bulat, latar text-primary. -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.NotchBg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="20" Background="{StaticResource Peeko.Brush.TextPrimary}">
                            <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"
                                  Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.LayoutTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </Path.LayoutTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag" Value="{StaticResource IconPlay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource IconPause}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Ringkas (0.3.0): satu baris cover 64 · info · kontrol, lalu progress. Lirik tampil di bawahnya
         (modul Lirik versi pita), digabung oleh NotchWindow. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cover 64, radius 14. Kosong: Kedip redup. -->
            <Border CornerRadius="{StaticResource Peeko.Radius.Lg}" Background="{StaticResource Peeko.Brush.SurfaceRaised}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasCover, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <Rectangle Width="6" Height="10" RadiusX="3" RadiusY="3" Fill="{StaticResource Peeko.Brush.TextTertiary}" />
                        <Rectangle Width="6" Height="10" RadiusX="3" RadiusY="3" Margin="10,0,0,0" Fill="{StaticResource Peeko.Brush.TextTertiary}" />
                    </StackPanel>
                    <Border CornerRadius="{StaticResource Peeko.Radius.Lg}"
                            Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- Info lagu -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                        Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
                <Canvas x:Name="TitleCanvas" Height="21" ClipToBounds="True">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Peeko.Text.Title}" Text="{Binding Title}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
                <TextBlock Style="{StaticResource Peeko.Text.Body}" Foreground="{StaticResource Peeko.Brush.TextSecondary}"
                           Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                <!-- Chip sumber. Lebih dari satu sesi: "‹ ● Brave 1/2 ›" untuk memilih sumber (revisi #13). -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ChevronButton}" Tag="{StaticResource IconChevronLeft}"
                            Command="{Binding PreviousSessionCommand}" ToolTip="Sumber sebelumnya" Margin="0,0,2,0"
                            Visibility="{Binding HasMultipleSessions, Converter={StaticResource Vis}}" />
                    <Border Height="20" Padding="6,0,9,0" CornerRadius="10" Background="{StaticResource Peeko.Brush.SurfaceRaised}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding SourceBrush}" />
                            <TextBlock Style="{StaticResource Peeko.Text.Caption}" FontWeight="SemiBold" Margin="5,0,0,0"
                                       Foreground="{StaticResource Peeko.Brush.TextSecondary}" Text="{Binding SourceName}" />
                            <TextBlock Style="{StaticResource Peeko.Text.Caption}" Margin="6,0,0,0" Text="{Binding SessionLabel}"
                                       Visibility="{Binding HasMultipleSessions, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChevronButton}" Tag="{StaticResource IconChevronRight}"
                            Command="{Binding NextSessionCommand}" ToolTip="Sumber berikutnya" Margin="2,0,0,0"
                            Visibility="{Binding HasMultipleSessions, Converter={StaticResource Vis}}" />
                    <!-- Pin lirik (issue #1): notch yang mengecil menampilkan baris lirik yang sedang diputar -->
                    <Button x:Name="PinButton" Style="{StaticResource ChevronButton}" Tag="{StaticResource Peeko.Icon.Pin}"
                            Margin="6,0,0,0" ToolTip="Pin lirik: tampilkan di notch saat mengecil" Click="OnPinClick" />
                    <controls:Visualizer x:Name="Bars" Margin="8,0,0,0" BarCount="5" BarWidth="4" BarGap="2"
                                         MaxBarHeight="18" BarBrush="{Binding AccentBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Kosong -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                        Visibility="{Binding HasSession, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource Peeko.Text.Title}" Text="Belum ada yang diputar" />
                <TextBlock Style="{StaticResource Peeko.Text.Body}" Foreground="{StaticResource Peeko.Brush.TextSecondary}"
                           Margin="0,2,0,0" MaxWidth="240" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Text="Putar lagu di Spotify, browser, atau pemutar lain." />
            </StackPanel>

            <!-- Kontrol -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPrev}"
                        Command="{Binding PreviousCommand}" ToolTip="Sebelumnya" />
                <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconNext}"
                        Command="{Binding NextCommand}" ToolTip="Berikutnya" />
            </StackPanel>
        </Grid>

        <!-- Progress. Disembunyikan jika pemutar tidak melaporkan posisi. -->
        <StackPanel Grid.Row="2" Visibility="{Binding HasTimeline, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Peeko.Text.Caption}" VerticalAlignment="Center" Text="{Binding PositionText}" />
                <controls:SeekBar x:Name="Seek" Grid.Column="1" Margin="6,0"
                                  Progress="{Binding Progress, Mode=OneWay}" IsSeekable="{Binding CanSeek}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Peeko.Text.Caption}" VerticalAlignment="Center"
                           TextAlignment="Right" Text="{Binding DurationText}" />
            </Grid>
            <TextBlock Style="{StaticResource Peeko.Text.Caption}" Margin="40,2,0,0" Text="Sumber ini tidak mendukung geser posisi"
                       Visibility="{Binding CanSeek, Converter={StaticResource Vis}, ConverterParameter=invert}" />
        </StackPanel>
    </Grid>
</UserControl>
