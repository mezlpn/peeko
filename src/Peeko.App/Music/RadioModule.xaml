<!-- Tab Radio, 440 × 150: POPULER / FAVORIT, kotak cari, daftar stasiun. -->
<UserControl x:Class="Peeko.App.Music.RadioModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Height="150">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PopularTab" Style="{StaticResource Peeko.Text.Overline}" Cursor="Hand" Text="POPULER" MouseLeftButtonUp="OnPopular" />
            <TextBlock x:Name="FavoriteTab" Style="{StaticResource Peeko.Text.Overline}" Cursor="Hand" Text="FAVORIT" Margin="14,0,0,0"
                       MouseLeftButtonUp="OnFavorites" />
        </StackPanel>
        <!-- Cari stasiun: Enter mencari, Esc mengosongkan -->
        <Grid Width="190" Height="26" HorizontalAlignment="Right">
            <Border CornerRadius="13" Background="{StaticResource Peeko.Brush.SurfaceRaised}" />
            <TextBox x:Name="SearchBox" Margin="12,0,8,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Peeko.Brush.TextPrimary}" CaretBrush="{DynamicResource Peeko.Brush.Accent}"
                     FontFamily="{StaticResource Peeko.Font}" FontSize="12" MaxLength="60"
                     PreviewMouseLeftButtonDown="OnSearchMouse" GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchBlur" KeyDown="OnSearchKey" TextChanged="OnSearchText" />
            <TextBlock x:Name="SearchHint" Style="{StaticResource Peeko.Text.Caption}" Margin="13,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Text="Cari stasiun…" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="List" />
        </ScrollViewer>
    </Grid>
</UserControl>
