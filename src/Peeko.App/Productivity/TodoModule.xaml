<!-- Modul Tugas (WaterTodo.dc.html): header jumlah + tombol tambah, baris 32 px, input saat menambah. -->
<UserControl x:Class="Peeko.App.Productivity.TodoModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource Peeko.Text.Overline}" Foreground="{StaticResource Peeko.Brush.TextTertiary}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Text="TUGAS" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Style="{StaticResource Peeko.Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Plus}" Height="28" Width="28"
                        Foreground="{StaticResource Peeko.Brush.TextPrimary}" ToolTip="Tambah tugas" Click="OnAddClick" />
            </StackPanel>
        </Grid>

        <!-- Input tugas baru: Enter menambah dan mengosongkan untuk tugas berikutnya, Esc menutup. -->
        <Grid x:Name="InputRow" Grid.Row="1" Height="32" Margin="0,4,0,2" Visibility="Collapsed">
            <Border CornerRadius="{StaticResource Peeko.Radius.Md}" Background="{StaticResource Peeko.Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource Peeko.Brush.StrokeStrong}" BorderThickness="1" />
            <TextBox x:Name="Input" Margin="10,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Peeko.Brush.TextPrimary}" CaretBrush="{StaticResource Peeko.Brush.Accent}"
                     SelectionBrush="{StaticResource Peeko.Brush.Accent}" FontFamily="{StaticResource Peeko.Font}" FontSize="13"
                     MaxLength="200" KeyDown="OnInputKeyDown" LostKeyboardFocus="OnInputLostFocus" TextChanged="OnInputTextChanged" />
            <TextBlock x:Name="Placeholder" Style="{StaticResource Peeko.Text.Body}" Margin="12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Peeko.Brush.TextTertiary}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                       Text="mis. besok jam 7 kumpul laporan" />
            <!-- Tenggat yang terbaca dari ketikan, sebelum Enter -->
            <Border x:Name="DuePreview" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Height="20" Padding="8,0"
                    CornerRadius="10" Background="{StaticResource Peeko.Brush.AccentMuted}" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="DuePreviewText" Style="{StaticResource Peeko.Text.Caption}" FontWeight="SemiBold"
                           Foreground="{StaticResource Peeko.Brush.Accent}" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="List" />
        </ScrollViewer>

        <!-- Kosong -->
        <StackPanel x:Name="EmptyView" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Peeko.Text.BodyStrong}" HorizontalAlignment="Center" Text="Belum ada tugas" />
            <TextBlock Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,10" TextAlignment="Center"
                       Text="Tulis tenggatnya langsung: “jam 3 sore telepon ibu”" />
            <Button Style="{StaticResource Peeko.Button.PillSecondary}" HorizontalAlignment="Center"
                    Tag="{StaticResource Peeko.Fill.Plus}" Content="Tambah tugas" Click="OnAddClick" />
        </StackPanel>

        <!-- Konfeti saat semua tugas selesai -->
        <Canvas x:Name="ConfettiLayer" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
