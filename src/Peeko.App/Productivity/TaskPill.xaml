<!-- Tugas bertenggat di pil: kotak centang yang bisa diklik · teks tugas · sisa menit, atau chip tunda saat waktunya tiba. -->
<UserControl x:Class="Peeko.App.Productivity.TaskPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <Grid Margin="10,0,4,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="CheckButton" Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Tandai selesai"
                VerticalAlignment="Center" Click="OnCheck">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource Peeko.Brush.TextSecondary}" Background="Transparent" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Peeko.Brush.Accent}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Peeko.Brush.AccentMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock x:Name="TaskText" Grid.Column="1" Style="{StaticResource Peeko.Text.Pill}" Margin="6,0,8,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

        <TextBlock x:Name="LeftText" Grid.Column="2" Style="{StaticResource Peeko.Text.Pill}" Margin="0,0,8,0"
                   Foreground="{StaticResource Peeko.Brush.Rest}" VerticalAlignment="Center" IsHitTestVisible="False" />

        <Button x:Name="SnoozeButton" Grid.Column="2" Height="24" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Tunda 10 menit"
                VerticalAlignment="Center" Visibility="Collapsed" Click="OnSnooze">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="12" Padding="10,0" Background="{StaticResource Peeko.Brush.RestMuted}">
                        <TextBlock Style="{StaticResource Peeko.Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource Peeko.Brush.Rest}" Text="+10 mnt" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33291A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
