<!-- Modul Fokus di tampilan Hari ini: pilihan Pomodoro / Timer / Stopwatch, stadium 224 × 100,
     lalu titik sesi (atau pilihan durasi / putaran) dan tombol. -->
<UserControl x:Class="Peeko.App.Productivity.FocusModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextTertiary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="11" Padding="10,0" Background="Transparent">
                            <TextBlock Style="{StaticResource Peeko.Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Padding="8,0" Background="{StaticResource Peeko.Brush.SurfaceRaised}">
                            <TextBlock Style="{StaticResource Peeko.Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource Peeko.Brush.TextSecondary}" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Top" Width="224">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <RadioButton x:Name="SegPomodoro" Style="{StaticResource Seg}" GroupName="FocusKind" Content="Pomodoro" Checked="OnKind" />
            <RadioButton x:Name="SegTimer" Style="{StaticResource Seg}" GroupName="FocusKind" Content="Timer" Checked="OnKind" />
            <RadioButton x:Name="SegStopwatch" Style="{StaticResource Seg}" GroupName="FocusKind" Content="Stopwatch" Checked="OnKind" />
        </StackPanel>

        <!-- Stadium: track + garis sisa waktu yang menyusut searah jarum jam dari puncak tengah -->
        <Grid Width="224" Height="100" HorizontalAlignment="Left">
            <Path x:Name="Track" StrokeThickness="4" Stroke="{StaticResource Peeko.Brush.SurfaceHover}" />
            <Path x:Name="Progress" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ModeLabel" Style="{StaticResource Peeko.Text.Overline}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TimeText" Style="{StaticResource Peeko.Text.TimerDisplay}" FontSize="36" HorizontalAlignment="Center" />
            </StackPanel>
            <!-- Timer siap: kurangi/tambah durasi -->
            <Button x:Name="MinusButton" Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Minus}" Width="26" Height="26"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,14,0,0" ToolTip="Kurangi 1 menit" Click="OnMinus" />
            <Button x:Name="PlusButton" Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Plus}" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,16,0" ToolTip="Tambah 1 menit" Click="OnPlus" />
        </Grid>

        <Grid Margin="0,10,0,0" Width="224" HorizontalAlignment="Left">
            <!-- Pomodoro: titik sesi -->
            <StackPanel x:Name="SessionInfo" VerticalAlignment="Center">
                <TextBlock x:Name="SessionText" Style="{StaticResource Peeko.Text.Overline}" Foreground="{StaticResource Peeko.Brush.TextTertiary}" />
                <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="0,4,0,0" />
            </StackPanel>
            <!-- Timer siap: durasi cepat; timer berjalan / stopwatch: keterangan -->
            <StackPanel x:Name="Presets" Orientation="Horizontal" VerticalAlignment="Center" />
            <TextBlock x:Name="SideText" Style="{StaticResource Peeko.Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="110" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ResetButton" Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Reset}"
                        ToolTip="Ulangi" Click="OnReset" />
                <Button x:Name="SkipButton" Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Skip}"
                        ToolTip="Lewati" Margin="0,0,6,0" Click="OnSkip" />
                <Button x:Name="PrimaryButton" Style="{StaticResource Peeko.Button.Pill}" Click="OnPrimary" />
            </StackPanel>
        </Grid>
        <!-- Keterangan sesi disimpan sebagai tooltip supaya tampilan tetap ringkas. -->
        <TextBlock x:Name="InfoText" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
