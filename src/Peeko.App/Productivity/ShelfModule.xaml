<!-- Modul Rak (Shelf.dc.html): zona drop 520 × 170 saat kosong; kartu 88 px saat berisi.
     Saat file diseret, zona terbelah: kiri "Simpan di rak", kanan "Ubah format" (Filee). -->
<UserControl x:Class="Peeko.App.Productivity.ShelfModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Peeko.App.Conversion">
    <Grid>
        <!-- ── Kosong / file sedang diseret di atasnya ── -->
        <Grid x:Name="Zones">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ConvertColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DropZone" Cursor="Hand" MouseLeftButtonUp="OnZoneClick" Background="Transparent"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ZoneScale" />
                </Grid.RenderTransform>
                <Rectangle x:Name="ZoneFill" RadiusX="16" RadiusY="16" Fill="Transparent" />
                <Rectangle x:Name="ZoneBorder" RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="4 2.67"
                           Stroke="{StaticResource Peeko.Brush.StrokeStrong}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                    <Path x:Name="ZoneIcon" Style="{StaticResource Peeko.IconPath}" Data="{StaticResource Peeko.Icon.Upload}"
                          Stroke="{StaticResource Peeko.Brush.TextSecondary}" HorizontalAlignment="Center">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="ZoneIconBob" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock x:Name="ZoneTitle" Style="{StaticResource Peeko.Text.BodyStrong}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Text="Seret file, teks, atau tautan ke sini" />
                    <TextBlock x:Name="ZoneDetail" Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" Text="Simpan sementara, lalu seret keluar ke mana saja" />
                    <TextBlock x:Name="ZonePhoneLink" Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{DynamicResource Peeko.Brush.Accent}" Cursor="Hand" Text="atau kirim dari HP"
                               MouseLeftButtonUp="OnPhoneLink" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ConvertZone" Grid.Column="1" Margin="10,0,0,0" Background="Transparent" Visibility="Collapsed">
                <Rectangle x:Name="ConvertFill" RadiusX="16" RadiusY="16" Fill="Transparent" />
                <Rectangle x:Name="ConvertBorder" RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="4 2.67"
                           Stroke="{StaticResource Peeko.Brush.StrokeStrong}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                    <Path x:Name="ConvertIcon" Style="{StaticResource Peeko.IconPath}" Data="{StaticResource Peeko.Icon.Convert}"
                          Stroke="{StaticResource Peeko.Brush.TextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConvertTitle" Style="{StaticResource Peeko.Text.BodyStrong}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Text="Ubah format" />
                    <TextBlock Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" Text="PNG, PDF, Word, dan lainnya" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── Berisi ── -->
        <Grid x:Name="FilledView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Style="{StaticResource Peeko.Text.Overline}" Foreground="{StaticResource Peeko.Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="4,0,0,0" Text="RAK" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Peeko.Text.Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Style="{StaticResource Peeko.Button.Text}" Content="Dari HP" ToolTip="Kirim file atau teks dari HP lewat Wi-Fi yang sama"
                            Click="OnPhone" />
                    <Button Style="{StaticResource Peeko.Button.Text}" Content="Bersihkan" Click="OnClear" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="CardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnCardWheel">
                <StackPanel x:Name="Cards" Orientation="Horizontal" Margin="0,6,0,0" />
            </ScrollViewer>
        </Grid>

        <!-- ── Kirim dari HP: kode QR berisi alamat server lokal sementara ── -->
        <Grid x:Name="PhoneView" Visibility="Collapsed" Background="{DynamicResource Peeko.Brush.NotchBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="128" Height="128" CornerRadius="12" Background="White" Padding="4" VerticalAlignment="Top">
                <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,30,0">
                <TextBlock Style="{StaticResource Peeko.Text.BodyStrong}" Text="Kirim dari HP" />
                <TextBlock Style="{StaticResource Peeko.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Sambungkan HP ke Wi-Fi yang sama, lalu pindai kode ini dengan kamera. File masuk ke folder Unduhan dan muncul di Rak." />
                <TextBlock x:Name="PhoneUrl" Style="{StaticResource Peeko.Text.Caption}" Foreground="{StaticResource Peeko.Brush.TextSecondary}"
                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PhoneStatus" Style="{StaticResource Peeko.Text.Caption}" Foreground="{DynamicResource Peeko.Brush.Accent}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Peeko.Button.Icon}" Tag="{StaticResource Peeko.Icon.Close}" Width="24" Height="24"
                    HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Tutup dan matikan penerima" Click="OnPhoneClose" />
        </Grid>

        <!-- ── Ubah format: menimpa isi rak selama berjalan ── -->
        <conv:ConvertPanel x:Name="ConvertPanelView" Visibility="Collapsed" />
    </Grid>
</UserControl>
