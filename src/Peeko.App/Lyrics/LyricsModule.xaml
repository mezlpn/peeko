<!-- Lirik (Lyrics.dc.html), versi pita ringkas 0.3.0 yang menempel di bawah pemutar musik. -->
<UserControl x:Class="Peeko.App.Lyrics.LyricsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Peeko.App.Controls">
    <UserControl.Resources>
        <controls:EqualsToVisibilityConverter x:Key="Is" />
        <controls:BoolToVisibilityConverter x:Key="Vis" />

        <!-- Tombol pil 32 px untuk "Cari lagi" (utama) dan "Lihat di peramban" (teks). -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource Peeko.Brush.SurfaceRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Style="{StaticResource Peeko.Text.Pill}" Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
        </Style>

        <Style x:Key="Skeleton" TargetType="Border">
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="13,6,0,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource Peeko.Brush.SurfaceHover}" />
        </Style>
    </UserControl.Resources>

    <!-- Pita lirik ringkas (0.3.0) di bawah pemutar musik: tiga slot 22 px, baris aktif di tengah.
         Tinggi diatur NotchWindow: 66 untuk lirik/memuat, 28 untuk pesan satu baris. -->
    <Grid>
        <!-- ── Tersinkron ── -->
        <Grid x:Name="SyncedView" Height="66" VerticalAlignment="Top" ClipToBounds="True"
              Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Synced}">
            <Rectangle x:Name="ActiveMarker" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,25,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource Peeko.Brush.Accent}" />
            <Canvas x:Name="LinesCanvas" Margin="13,0,0,0">
                <StackPanel x:Name="LinesPanel">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LinesShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>
        </Grid>

        <!-- ── Teks biasa: bisa di-scroll, tepi bawah memudar ── -->
        <ScrollViewer x:Name="PlainView" Height="66" VerticalAlignment="Top" VerticalScrollBarVisibility="Hidden" Padding="2,0,0,0"
                      Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Plain}">
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.6" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <TextBlock Style="{StaticResource Peeko.Text.Body}" Foreground="{StaticResource Peeko.Brush.TextSecondary}"
                       TextWrapping="Wrap" Text="{Binding PlainText}" Margin="11,0,0,24" />
        </ScrollViewer>

        <!-- ── Memuat ── -->
        <StackPanel x:Name="LoadingView" VerticalAlignment="Top"
                    Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Loading}">
            <Border Style="{StaticResource Skeleton}" Width="200" />
            <Border Style="{StaticResource Skeleton}" Width="280" />
            <Border Style="{StaticResource Skeleton}" Width="160" />
        </StackPanel>

        <!-- ── Tidak ditemukan / gagal / instrumental / dimatikan: satu baris ── -->
        <Grid Height="28" VerticalAlignment="Top"
              Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed,Instrumental,Disabled'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Kedip "bingung": satu mata menyipit -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <Rectangle Width="4" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Peeko.Brush.TextTertiary}" />
                <Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Margin="5,4,0,0" Fill="{StaticResource Peeko.Brush.TextTertiary}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource Peeko.Text.Base}">
                <Run x:Name="EmptyTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Peeko.Brush.TextSecondary}" />
                <Run x:Name="EmptyBody" FontSize="12" Foreground="{StaticResource Peeko.Brush.TextTertiary}" />
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TextButton}" Content="Cari lagi" Command="{Binding RetryCommand}"
                        Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed'}" />
                <Button Style="{StaticResource TextButton}" Content="Peramban" Command="{Binding OpenInBrowserCommand}"
                        Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed'}" />
                <Button Style="{StaticResource TextButton}" Content="Pengaturan" Command="{Binding OpenSettingsCommand}"
                        Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Disabled}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
