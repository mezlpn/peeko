    <Geometry x:Key="Peeko.Icon.CloudStorm">M7,14 H17 A3.6,3.6 0 0 0 16.5,7 A5,5 0 0 0 6.4,8.3 A2.9,2.9 0 0 0 7,14 Z M12.5,15 L10.5,18.2 H13.5 L11.5,21.5</Geometry>
