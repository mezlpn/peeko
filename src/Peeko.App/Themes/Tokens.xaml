    <Geometry x:Key="Peeko.Icon.Wifi">M3.5,9.2 Q12,1.8 20.5,9.2 M6.6,12.4 Q12,7.6 17.4,12.4 M9.6,15.6 Q12,13.6 14.4,15.6 M12,18.8 V19.2</Geometry>
