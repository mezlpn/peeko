    <!-- Rak: teks dan tautan -->
    <Geometry x:Key="Peeko.Icon.Link">M10,14 A4,4 0 0 0 15.7,14 L18.5,11.2 A4,4 0 0 0 12.8,5.5 L11.5,6.8 M14,10 A4,4 0 0 0 8.3,10 L5.5,12.8 A4,4 0 0 0 11.2,18.5 L12.5,17.2</Geometry>
    <Geometry x:Key="Peeko.Icon.Text">M5,6 H19 M5,10 H19 M5,14 H15 M5,18 H11</Geometry>

    <!-- Cuaca (baris status) -->
    <Geometry x:Key="Peeko.Icon.Cloud">M7,17 H17 A4,4 0 0 0 16.5,9.1 A5.5,5.5 0 0 0 6.2,10.6 A3.2,3.2 0 0 0 7,17 Z</Geometry>
