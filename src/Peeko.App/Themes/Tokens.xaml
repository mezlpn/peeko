<!-- Design tokens Peeko. Sumber: design/project/Tokens.dc.html. Semua nilai px @100%. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Warna: permukaan notch ── -->
    <Color x:Key="Peeko.Color.NotchBg">#050506</Color>
    <SolidColorBrush x:Key="Peeko.Brush.NotchBg" Color="#050506" />
    <SolidColorBrush x:Key="Peeko.Brush.SurfaceRaised" Color="#141417" />
    <SolidColorBrush x:Key="Peeko.Brush.SurfaceHover" Color="#1D1D21" />
    <SolidColorBrush x:Key="Peeko.Brush.SurfacePressed" Color="#26262B" />
    <SolidColorBrush x:Key="Peeko.Brush.Stroke" Color="#2A2A30" />
    <SolidColorBrush x:Key="Peeko.Brush.StrokeStrong" Color="#3A3A42" />

    <!-- ── Teks & ikon ── -->
    <SolidColorBrush x:Key="Peeko.Brush.TextPrimary" Color="#F4F4F1" />
    <SolidColorBrush x:Key="Peeko.Brush.TextSecondary" Color="#A6A6AD" />
    <SolidColorBrush x:Key="Peeko.Brush.TextTertiary" Color="#7A7A83" />
    <SolidColorBrush x:Key="Peeko.Brush.TextDisabled" Color="#4A4A52" />

    <!-- ── Aksen "Nyala" ── -->
    <SolidColorBrush x:Key="Peeko.Brush.Accent" Color="#C6F36B" />
    <SolidColorBrush x:Key="Peeko.Brush.AccentHover" Color="#D3F785" />
    <SolidColorBrush x:Key="Peeko.Brush.AccentPressed" Color="#A9D84F" />
    <SolidColorBrush x:Key="Peeko.Brush.AccentInk" Color="#0B0F04" />
    <SolidColorBrush x:Key="Peeko.Brush.AccentMuted" Color="#202614" />

    <!-- ── Semantik ── -->
    <SolidColorBrush x:Key="Peeko.Brush.Water" Color="#6CC8F2" />
    <SolidColorBrush x:Key="Peeko.Brush.WaterMuted" Color="#132027" />
    <SolidColorBrush x:Key="Peeko.Brush.Rest" Color="#F2B866" />
    <SolidColorBrush x:Key="Peeko.Brush.RestMuted" Color="#261E13" />
    <SolidColorBrush x:Key="Peeko.Brush.Warning" Color="#F5C84B" />
    <SolidColorBrush x:Key="Peeko.Brush.Danger" Color="#FF6B5B" />
    <SolidColorBrush x:Key="Peeko.Brush.DangerMuted" Color="#281312" />

    <!-- ── Jendela Pengaturan ── -->
    <SolidColorBrush x:Key="Peeko.Brush.WinTitlebar" Color="#141416" />
    <SolidColorBrush x:Key="Peeko.Brush.WinBg" Color="#1A1A1D" />
    <SolidColorBrush x:Key="Peeko.Brush.WinCard" Color="#232327" />
    <SolidColorBrush x:Key="Peeko.Brush.WinCardHover" Color="#2A2A2F" />
    <SolidColorBrush x:Key="Peeko.Brush.WinStroke" Color="#34343A" />

    <!-- ── Radius ── -->
    <CornerRadius x:Key="Peeko.Radius.Xs">4</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.Md">10</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.Lg">14</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.NotchPill">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.NotchPeek">0,0,22,22</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.NotchXl">0,0,28,28</CornerRadius>
    <CornerRadius x:Key="Peeko.Radius.Pill">999</CornerRadius>

    <!-- ── Spacing ── -->
    <sys:Double x:Key="Peeko.Space.2xs">2</sys:Double>
    <sys:Double x:Key="Peeko.Space.Xs">4</sys:Double>
    <sys:Double x:Key="Peeko.Space.Sm">6</sys:Double>
    <sys:Double x:Key="Peeko.Space.Md">8</sys:Double>
    <sys:Double x:Key="Peeko.Space.Lg">12</sys:Double>
    <sys:Double x:Key="Peeko.Space.Xl">16</sys:Double>
    <sys:Double x:Key="Peeko.Space.2xl">20</sys:Double>
    <sys:Double x:Key="Peeko.Space.3xl">24</sys:Double>
    <sys:Double x:Key="Peeko.Space.4xl">32</sys:Double>

    <!-- ── Tipografi (Segoe UI) ── -->
    <FontFamily x:Key="Peeko.Font">Segoe UI</FontFamily>
    <FontFamily x:Key="Peeko.Font.Icons">Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Peeko.Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Peeko.Font}" />
        <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="Peeko.Text.TimerDisplay" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="LineHeight" Value="48" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Peeko.Text.LyricActive" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Peeko.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Peeko.Text.LyricDim" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextTertiary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Peeko.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Peeko.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="Peeko.Text.Pill" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Peeko.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextTertiary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Peeko.Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="LineHeight" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
    </Style>

    <!-- ── Ikon garis (path dari desain, viewBox 24, stroke 1.8) ── -->
    <Geometry x:Key="Peeko.Icon.Music">M9,18 V6 L19,4 V16 M4,18 A2.5,2.5 0 1 0 9,18 A2.5,2.5 0 1 0 4,18 M14,16 A2.5,2.5 0 1 0 19,16 A2.5,2.5 0 1 0 14,16</Geometry>
