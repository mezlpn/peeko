<!-- Tab Sistem, 440 × 150: kiri pemakaian perangkat (CPU, RAM, GPU, disk/suhu),
     kanan progres hari atau screen time (pilih lewat dua label di atasnya). -->
<UserControl x:Class="Peeko.App.Sistem.SystemModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Height="150">
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Overline}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Switch" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Overline}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Perangkat -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Head}" Text="PERANGKAT" />
            <TextBlock x:Name="UptimeText" Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       ToolTip="Lama Windows menyala sejak terakhir dinyalakan ulang" />
            <StackPanel x:Name="StatsPanel" Grid.Row="1" Margin="0,6,0,0" />
        </Grid>

        <!-- Progres / screen time -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ProgressTab" Style="{StaticResource Switch}" Text="PROGRES" MouseLeftButtonUp="OnProgressTab" />
                <TextBlock x:Name="ScreenTab" Style="{StaticResource Switch}" Text="SCREEN TIME" Margin="14,0,0,0" MouseLeftButtonUp="OnScreenTab" />
            </StackPanel>
            <TextBlock x:Name="ScreenTotal" Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <StackPanel x:Name="RightPanel" Grid.Row="1" Margin="0,6,0,0" />
        </Grid>
    </Grid>
</UserControl>
