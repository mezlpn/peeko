<!-- Tab Salat: salat berikutnya + hitung mundur di kiri, jadwal hari ini di kanan. -->
<UserControl x:Class="Peeko.App.Prayer.PrayerModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="148">
    <Grid>
        <Grid x:Name="ScheduleView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Style="{StaticResource Peeko.Text.Overline}" Foreground="{StaticResource Peeko.Brush.TextTertiary}" Text="SALAT BERIKUTNYA" />
                <TextBlock x:Name="NextName" Style="{StaticResource Peeko.Text.TimerDisplay}" FontSize="30" Margin="0,4,0,0" />
                <TextBlock x:Name="NextLeft" Style="{StaticResource Peeko.Text.BodyStrong}" Foreground="{StaticResource Peeko.Brush.Rest}" />
                <TextBlock x:Name="PlaceText" Style="{StaticResource Peeko.Text.Caption}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HijriText" Style="{StaticResource Peeko.Text.Caption}" Foreground="{StaticResource Peeko.Brush.TextTertiary}"
                           ToolTip="Perkiraan kalender Umm al-Qura; bisa berbeda sehari dengan ketetapan Kemenag" />
                <Button x:Name="StopAdhan" Style="{StaticResource Peeko.Button.PillSecondary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Tag="{StaticResource Peeko.Fill.Pause}" Content="Hentikan azan" Visibility="Collapsed" Click="OnStopAdhan" />
            </StackPanel>

            <StackPanel x:Name="Rows" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,4,0" />
        </Grid>

        <!-- Lokasi belum diketahui (tanpa internet saat pertama dibuka) -->
        <StackPanel x:Name="NoLocationView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Peeko.Text.BodyStrong}" HorizontalAlignment="Center" Text="Lokasi belum diketahui" />
            <TextBlock Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,10" TextAlignment="Center"
                       Text="Isi kotamu di Pengaturan → Cuaca, jadwal dihitung dari situ" />
            <Button Style="{StaticResource Peeko.Button.PillSecondary}" HorizontalAlignment="Center"
                    Content="Buka pengaturan" Click="OnOpenSettings" />
        </StackPanel>
    </Grid>
</UserControl>
