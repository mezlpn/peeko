<!-- Jendela Pengaturan (Settings.dc.html): 960 × 720 (min 720 × 520), title bar kustom gelap,
     navigasi kiri sebagai anchor, semua perubahan langsung diterapkan. -->
<Window x:Class="Peeko.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Peeko.App.Controls"
        Title="Pengaturan Peeko" Width="960" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Peeko.Brush.WinBg}"
        FontFamily="{StaticResource Peeko.Font}" Foreground="{StaticResource Peeko.Brush.TextPrimary}"
        Icon="pack://application:,,,/Assets/peeko.ico" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Peeko.Brush.WinCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource Peeko.Brush.WinStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Baris kartu: min 46 px, padding 8 14, garis pemisah di atas kecuali baris pertama -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#2C2C31" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Base}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="12,0">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource Peeko.Brush.Accent}" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.WinCardHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.WinCard}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tombol bergaris di dalam kartu (Pasang, Hapus, Buka Filee) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Peeko.Brush.WinStroke}"
                                Background="{StaticResource Peeko.Brush.WinBg}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Peeko.Brush.WinCardHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextDisabled}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Peeko.Button.Flat}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Tag" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource Peeko.Brush.WinTitlebar}">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/peeko.ico" Width="16" Height="16" />
                <TextBlock Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Peeko.Brush.TextSecondary}"
                           Text="Pengaturan Peeko" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimalkan">
                    <Path Data="M7,12 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="24" Height="24">
                        <Path.LayoutTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Path.LayoutTransform>
                    </Path>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="Tutup">
                    <Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="24" Height="24">
                        <Path.LayoutTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Path.LayoutTransform>
                    </Path>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigasi -->
            <Border BorderBrush="#26262B" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                        <Image Source="pack://application:,,,/Assets/peeko.ico" Width="36" Height="36" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="20" LineHeight="26" FontWeight="SemiBold" Text="Peeko" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Peeko.Brush.TextTertiary}" Text="{Binding Version, StringFormat='versi {0}'}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="12,0" FontSize="11" LineHeight="15" TextWrapping="Wrap"
                               Foreground="{StaticResource Peeko.Brush.TextTertiary}" Text="Pintasan: Win + Alt + C membuka notch" />
                    <StackPanel x:Name="Nav">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Tag="Umum" Content="Umum" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Tampilan" Content="Tampilan" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Modul" Content="Modul" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Baterai" Content="Baterai" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Minum" Content="Minum air" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Sehat" Content="Kesehatan" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Fokus" Content="Timer fokus" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Tugas" Content="Tugas" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Salat" Content="Jadwal salat" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Lirik" Content="Lirik" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Cuaca" Content="Cuaca &amp; kalender" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Ubah" Content="Ubah format" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Cadangan" Content="Cadangan" Checked="OnNav" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Isi -->
            <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Sections" Margin="28,24,4,24" ItemWidth="{Binding ActualWidth, ElementName=ColumnProbe}">
                    <!-- Kolom kiri -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel x:Name="Umum" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="UMUM" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Mulai bersama Windows" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Berjalan diam-diam di tray" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,120,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Garis tipis" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Saat jendela aktif menempel ke tepi atas, mis. tab Chrome" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" MinWidth="110" Click="OnSlimMode"
                                                Style="{StaticResource Peeko.Button.Flat}" Tag="6" BorderThickness="1">
                                            <Border CornerRadius="6" BorderBrush="{StaticResource Peeko.Brush.WinStroke}" BorderThickness="1"
                                                    Background="{StaticResource Peeko.Brush.WinBg}" Padding="10,0" Height="30" MinWidth="110">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" Text="{Binding SlimModeText}" />
                                                    <Path Data="M6,9.5 L12,15.5 L18,9.5" Stroke="{StaticResource Peeko.Brush.TextSecondary}" StrokeThickness="2"
                                                          Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Path.LayoutTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Path.LayoutTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,150,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Isi notch tertutup" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Kiri dan kanan mata, juga saat lagu diputar" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource CardButton}" MinWidth="70" Tag="Left" Click="OnSlot" Content="{Binding CollapsedLeftText}" ToolTip="Kiri" />
                                            <Button Style="{StaticResource CardButton}" MinWidth="70" Margin="6,0,0,0" Tag="Right" Click="OnSlot" Content="{Binding CollapsedRightText}" ToolTip="Kanan" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,140,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Geser horizontal" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Hindari webcam atau tombol jendela" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource Peeko.SliderCentered}" Width="96" Minimum="-300" Maximum="300"
                                                    SmallChange="10" LargeChange="50" Value="{Binding HorizontalOffset}" />
                                            <TextBlock Width="40" Margin="8,0,0,0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Peeko.Brush.TextSecondary}" Text="{Binding HorizontalOffset, StringFormat='{}{0:+0;-0;0} px'}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Sembunyikan saat layar penuh" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Game, video, presentasi" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HideOnFullscreen}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Tampilan" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="TAMPILAN" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,0,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Warna aksen" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Tombol, centang, dan sorotan di notch" />
                                            <WrapPanel x:Name="AccentSwatches" Margin="0,10,0,2" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,140,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Latar notch" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Kaca: desktop sedikit terlihat di balik notch" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" MinWidth="130" Click="OnNotchStyle"
                                                Style="{StaticResource Peeko.Button.Flat}" Tag="6" BorderThickness="1">
                                            <Border CornerRadius="6" BorderBrush="{StaticResource Peeko.Brush.WinStroke}" BorderThickness="1"
                                                    Background="{StaticResource Peeko.Brush.WinBg}" Padding="10,0" Height="30" MinWidth="130">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" Text="{Binding NotchStyleText}" />
                                                    <Path Data="M6,9.5 L12,15.5 L18,9.5" Stroke="{StaticResource Peeko.Brush.TextSecondary}" StrokeThickness="2"
                                                          Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Path.LayoutTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Path.LayoutTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Modul" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="MODUL" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Musik" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MusicEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Lirik" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LyricsEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Cahaya warna sampul" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CoverGlowEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Timer fokus" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding FocusEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Minum air" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding WaterEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Jadwal salat" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding PrayerEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="To-do" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding TodoEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Catatan &amp; flashcard" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding NotesEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Kesehatan (istirahat, mata, napas)" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HealthEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Rak file" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShelfEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Sistem (CPU, RAM, progres hari)" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SystemEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Screen time" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Lama tiap aplikasi dipakai, tampil di tab Sistem. Hanya nama aplikasi yang dicatat, di laptop ini saja." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ScreenTimeEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Aplikasi favorit" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LauncherEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Riwayat clipboard" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Teks yang disalin muncul di tab Clipboard. Hanya yang di-pin yang disimpan; isi dari password manager diabaikan." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ClipboardEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Snap zones" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Seret jendela ke notch, lalu lepas di zona (kiri, kanan, sepertiga…) untuk menatanya." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SnapZonesEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Radio internet" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Ribuan stasiun dari Radio Browser (radio-browser.info). Butuh internet; daftar diambil saat tab Radio dibuka." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding RadioEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Kontrol (Wi-Fi, Bluetooth, volume…)" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ControlEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Hari ini (kalender, cuaca, baterai)" />
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding TodayEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Peek sistem" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Volume, kecerahan, Caps Lock, jaringan… Baterai kritis selalu muncul." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SystemPeeksEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kolom kanan -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel x:Name="Baterai" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="BATERAI" />
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Margin="0,0,48,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Ingatkan saat baterai di bawah" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Peringatan kritis selalu muncul di 10%" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Peeko.Brush.Accent}"
                                                   Text="{Binding BatteryThreshold, StringFormat='{}{0}%'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource Peeko.Slider}" Margin="0,10,0,0" Minimum="10" Maximum="50" SmallChange="5" LargeChange="5"
                                            IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding BatteryThreshold}" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource Peeko.Brush.TextTertiary}" Text="10%" />
                                        <TextBlock FontSize="10" Foreground="{StaticResource Peeko.Brush.TextTertiary}" HorizontalAlignment="Right" Text="50%" />
                                    </Grid>
