                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Istirahat pendek" />
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="1" Maximum="30" Suffix="mnt"
                                                          Value="{Binding ShortBreakMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Istirahat panjang" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Setelah 4 sesi" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="5" Maximum="60" Step="5" Suffix="mnt"
                                                          Value="{Binding LongBreakMinutes}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Tugas" Margin="0,0,0,22">
