                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Hitung mundur di notch" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Sekian menit sebelum tenggat; 0 = hanya saat tenggat" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="0" Maximum="60" Step="5" Suffix="mnt"
