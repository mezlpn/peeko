                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding EyeBreaksEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

