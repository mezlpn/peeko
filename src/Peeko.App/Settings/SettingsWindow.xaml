                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Peeko.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ConfettiEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Salat" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="JADWAL SALAT" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Ingatkan sebelum waktu salat" />
                                            <TextBlock Style="{StaticResource Hint}" Text="0 = hanya saat masuk waktu" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="0" Maximum="60" Step="5" Suffix="mnt"
                                                          Value="{Binding PrayerReminderMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Hitung mundur di notch" />
