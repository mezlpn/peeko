                                            <Button Style="{StaticResource CardButton}" Margin="8,0,0,0" Content="Pilih file…" Click="OnPickAdhan" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Foreground="{StaticResource Peeko.Brush.TextTertiary}"
