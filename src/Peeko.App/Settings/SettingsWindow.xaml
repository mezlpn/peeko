                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="0" Maximum="60" Step="5" Suffix="mnt"
                                                          Value="{Binding PrayerCountdownMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Koreksi waktu" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Samakan dengan jadwal masjid setempat" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="-10" Maximum="10" Suffix="mnt"
