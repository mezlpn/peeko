            </ScrollViewer>
            <!-- Lebar satu kolom: dua kolom bila cukup lebar, satu kolom bila jendela sempit -->
            <Border x:Name="ColumnProbe" Grid.Column="1" Visibility="Hidden" HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</Window>
