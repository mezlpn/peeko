                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Konfeti saat semua tugas selesai" />
