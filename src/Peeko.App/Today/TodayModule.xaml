<!-- Kalender bulan ini, diadaptasi dari Bloom (GPLv3). Tampil di kiri tampilan "Hari ini", di sebelah
     timer fokus. Cuaca dan baterai pindah ke baris status di atas notch. Lebar 196. -->
<UserControl x:Class="Peeko.App.Today.TodayModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Top" Width="196">
        <Grid Margin="2,0,0,4">
            <TextBlock x:Name="MonthTitle" Style="{StaticResource Peeko.Text.BodyStrong}" Text="Oktober 2026" />
            <TextBlock x:Name="DayName" Style="{StaticResource Peeko.Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <UniformGrid x:Name="WeekdayRow" Columns="7" Height="16" />
        <UniformGrid x:Name="DaysGrid" Columns="7" />
    </StackPanel>
</UserControl>
