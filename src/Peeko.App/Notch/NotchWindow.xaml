<Window x:Class="Peeko.App.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Peeko.App.Controls"
        xmlns:music="clr-namespace:Peeko.App.Music"
        xmlns:lyrics="clr-namespace:Peeko.App.Lyrics"
        xmlns:peeks="clr-namespace:Peeko.App.Peeks"
        xmlns:prod="clr-namespace:Peeko.App.Productivity"
        xmlns:upd="clr-namespace:Peeko.App.Updates"
        xmlns:ctl="clr-namespace:Peeko.App.Control"
        xmlns:today="clr-namespace:Peeko.App.Today"
        Title="Peeko"
        Width="640" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Peeko.Font}">

    <Window.Resources>
        <!-- Ikon kecil 14 px di baris status -->
        <Style x:Key="StatusIcon" TargetType="Path" BasedOn="{StaticResource Peeko.IconPath}">
            <Setter Property="Stroke" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.58" ScaleY="0.58" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Peeko.Text.Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Peeko.Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Bentuk notch: bahu kiri + badan + bahu kanan. Hanya area berwarna yang menerima hover. -->
        <StackPanel x:Name="ShapeHost" Orientation="Horizontal" AllowDrop="True"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="HideShift" />
            </StackPanel.RenderTransform>

            <!-- Bahu cekung 10 × 10 yang menyatukan pil dengan tepi layar -->
            <Path x:Name="LeftShoulder" Width="10" Height="10" VerticalAlignment="Top"
                  Fill="{StaticResource Peeko.Brush.NotchBg}" RenderTransformOrigin="1,0"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="LeftShoulderScale" />
                </Path.RenderTransform>
            </Path>

            <Border x:Name="Body" Width="200" Height="32" VerticalAlignment="Top"
                    CornerRadius="{StaticResource Peeko.Radius.NotchPill}"
                    Background="{StaticResource Peeko.Brush.NotchBg}" ClipToBounds="True">
                <Grid>
                    <!-- ── Collapsed ── -->
                    <Grid x:Name="CollapsedLayer" Height="32" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CollapsedScale" />
                        </Grid.RenderTransform>
                        <controls:Kedip x:Name="Kedip" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <music:MusicPill x:Name="MusicPillView" Opacity="0" Visibility="Collapsed" />
                        <prod:FocusPill x:Name="FocusPillView" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0" Visibility="Collapsed" />
                        <prod:WaterPill x:Name="WaterPillView" Opacity="0" Visibility="Collapsed" />
                        <upd:UpdatePill x:Name="UpdatePillView" Opacity="0" Visibility="Collapsed" />
                    </Grid>

                    <!-- ── Peek: tinggi 44, lebar 280–340 sesuai isi (Peek.dc.html) ── -->
                    <Grid x:Name="PeekLayer" Width="320" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Opacity="0" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PeekShift" />
                        </Grid.RenderTransform>
                        <peeks:PeekView x:Name="PeekContent" />
                    </Grid>

                    <!-- ── Expanded (0.3.0, gaya Bloom): baris status, isi tampilan, titik halaman.
                         Ukuran notch mengikuti isi tampilan; ganti tampilan dengan gulir mouse atau klik titik. ── -->
                    <Grid x:Name="ExpandedLayer" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseWheel="OnExpandedWheel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="10" />
                        </Grid.RowDefinitions>

                        <!-- Baris status: cuaca · mata + jam · baterai -->
                        <Grid x:Name="StatusBar" Grid.Row="1" Margin="18,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="StatusShift" />
                            </Grid.RenderTransform>
                            <StackPanel x:Name="WeatherBox" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="WeatherGlyph" Style="{StaticResource StatusIcon}" Data="{StaticResource Peeko.Icon.Thermo}" />
                                <TextBlock x:Name="WeatherText" Style="{StaticResource StatusText}" Margin="4,0,0,0" Text="–" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:Kedip x:Name="HeaderEyes" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <controls:Kedip.LayoutTransform>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                    </controls:Kedip.LayoutTransform>
                                </controls:Kedip>
                                <TextBlock x:Name="Clock" Style="{StaticResource Peeko.Text.BodyStrong}" VerticalAlignment="Center" Text="00:00" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Ada update: tombol kecil, bisa dipasang dari tampilan mana pun -->
                                <Button x:Name="UpdateChip" Style="{StaticResource Peeko.Button.Pill}" Height="22" Padding="8,0"
                                        Margin="0,0,10,0" Visibility="Collapsed" Tag="{StaticResource Peeko.Icon.UpdateArrow}" />
                                <Path x:Name="BatteryBolt" Style="{StaticResource StatusIcon}" Data="{StaticResource Peeko.Icon.Bolt}"
                                      Stroke="{StaticResource Peeko.Brush.Accent}" Visibility="Collapsed" Margin="0,0,1,0" />
                                <Border Width="20" Height="11" CornerRadius="3" BorderThickness="1.2" Padding="1.5" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Peeko.Brush.TextSecondary}">
                                    <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1" Width="8"
                                            Background="{StaticResource Peeko.Brush.TextSecondary}" />
                                </Border>
                                <Border Width="1.5" Height="4" Margin="1,0,0,0" CornerRadius="0,1,1,0" VerticalAlignment="Center"
                                        Background="{StaticResource Peeko.Brush.TextSecondary}" />
                                <TextBlock x:Name="BatteryText" Style="{StaticResource StatusText}" Margin="5,0,0,0" Text="–" />
                            </StackPanel>
                        </Grid>

                        <!-- Isi tampilan. Tinggi diatur kode sesuai tampilan aktif. -->
                        <Grid x:Name="ModuleHost" Grid.Row="3" Margin="18,0" ClipToBounds="True">
                            <StackPanel x:Name="MusicMode" Width="400" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <music:MusicModule x:Name="MusicModuleView" />
                                <lyrics:LyricsModule x:Name="LyricsModuleView" Margin="0,10,0,0" />
                            </StackPanel>
                            <ctl:ControlModule x:Name="ControlModuleView" Width="400" HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Visibility="Collapsed" />
                            <StackPanel x:Name="TodayMode" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                <today:TodayModule x:Name="TodayModuleView" />
                                <prod:FocusModule x:Name="FocusModuleView" Margin="20,0,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="TasksMode" Orientation="Horizontal" Height="150" HorizontalAlignment="Center"
                                        VerticalAlignment="Top" Visibility="Collapsed">
                                <prod:TodoModule x:Name="TodoModuleView" Width="250" />
                                <prod:WaterModule x:Name="WaterModuleView" Width="150" Margin="14,0,0,0" />
                            </StackPanel>
                            <prod:ShelfModule x:Name="ShelfModuleView" Width="440" Height="96" HorizontalAlignment="Center"
                                              VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>

                        <!-- Peek saat panel terbuka: baris 32 px di atas isi -->
                        <Border x:Name="PeekBanner" Grid.Row="3" Height="32" Margin="18,0" VerticalAlignment="Top"
                                CornerRadius="{StaticResource Peeko.Radius.Md}" Background="{StaticResource Peeko.Brush.SurfaceRaised}"
                                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <peeks:PeekView x:Name="PeekBannerContent" Compact="True" />
                        </Border>

                        <!-- Titik halaman: aktif memanjang, bisa diklik -->
                        <StackPanel x:Name="Dots" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Path x:Name="RightShoulder" Width="10" Height="10" VerticalAlignment="Top"
                  Fill="{StaticResource Peeko.Brush.NotchBg}" RenderTransformOrigin="0,0"
                  Data="M10,0 L0,0 L0,10 A10,10 0 0 1 10,0 Z">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="RightShoulderScale" />
                </Path.RenderTransform>
            </Path>
        </StackPanel>
    </Grid>
</Window>
