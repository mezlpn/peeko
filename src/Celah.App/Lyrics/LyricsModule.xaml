<!-- Modul Lirik 520 × 196 (Lyrics.dc.html): baris "sedang diputar" 32 px, lalu jendela lirik
     5 slot × 26 px dengan baris aktif di slot ketiga. -->
<UserControl x:Class="Celah.App.Lyrics.LyricsModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Celah.App.Controls">
    <UserControl.Resources>
        <controls:EqualsToVisibilityConverter x:Key="Is" />
        <controls:BoolToVisibilityConverter x:Key="Vis" />

        <!-- Tombol pil 32 px untuk "Cari lagi" (utama) dan "Lihat di peramban" (teks). -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource Celah.Brush.SurfaceRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Style="{StaticResource Celah.Text.Pill}" Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Celah.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Celah.Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextSecondary}" />
        </Style>

        <Style x:Key="Skeleton" TargetType="Border">
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="13,7,0,7" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource Celah.Brush.SurfaceHover}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Sedang diputar ── -->
        <Grid DataContext="{Binding Music}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Celah.Brush.SurfaceRaised}">
                <Border CornerRadius="7">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
            <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource Celah.Text.Base}">
                <Run Text="{Binding Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                <Run Text="{Binding Artist, Mode=OneWay, StringFormat='· {0}'}" FontSize="12"
                     Foreground="{StaticResource Celah.Brush.TextTertiary}" />
            </TextBlock>
            <TextBlock Grid.Column="2" Style="{StaticResource Celah.Text.Caption}" VerticalAlignment="Center"
                       Visibility="{Binding HasTimeline, Converter={StaticResource Vis}}">
                <Run Text="{Binding PositionText, Mode=OneWay}" /> / <Run Text="{Binding DurationText, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- ── Tersinkron ── -->
        <Grid x:Name="SyncedView" Grid.Row="2" Height="130" VerticalAlignment="Top" ClipToBounds="True"
              Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Synced}">
            <!-- Penanda accent 3 × 18 di slot ketiga -->
            <Rectangle x:Name="ActiveMarker" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="0,56,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource Celah.Brush.Accent}" />
            <Canvas x:Name="LinesCanvas" Margin="13,0,0,0">
                <StackPanel x:Name="LinesPanel">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LinesShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>
        </Grid>

        <!-- ── Teks biasa: bisa di-scroll, tepi bawah memudar ── -->
        <ScrollViewer x:Name="PlainView" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Padding="2,0,0,0"
                      Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Plain}">
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.7" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <TextBlock Style="{StaticResource Celah.Text.LyricDim}" Foreground="{StaticResource Celah.Brush.TextSecondary}"
                       TextWrapping="Wrap" Text="{Binding PlainText}" Margin="0,0,0,40" />
        </ScrollViewer>

        <!-- ── Memuat ── -->
        <StackPanel x:Name="LoadingView" Grid.Row="2"
                    Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Loading}">
            <Border Style="{StaticResource Skeleton}" Width="220" />
            <Border Style="{StaticResource Skeleton}" Width="300" />
            <Border Style="{StaticResource Skeleton}" Width="260" />
            <Border Style="{StaticResource Skeleton}" Width="180" />
            <TextBlock Style="{StaticResource Celah.Text.Caption}" Margin="13,8,0,0" Text="Mencari lirik di lrclib.net…" />
        </StackPanel>

        <!-- ── Tidak ditemukan / gagal / instrumental / tidak ada lagu ── -->
        <Grid Grid.Row="2" Margin="4,0"
              Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed,Instrumental,None,Disabled'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Height="88" CornerRadius="{StaticResource Celah.Radius.Lg}" Background="{StaticResource Celah.Brush.SurfaceRaised}">
                <Grid>
                    <!-- Kedip "bingung": satu mata menyipit -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed,None,Disabled'}">
                        <Rectangle Width="6" Height="10" RadiusX="3" RadiusY="3" Fill="{StaticResource Celah.Brush.TextSecondary}" />
                        <Rectangle Width="6" Height="5" RadiusX="2.5" RadiusY="2.5" Margin="10,4,0,0" Fill="{StaticResource Celah.Brush.TextSecondary}" />
                    </StackPanel>
                    <Path Style="{StaticResource Celah.IconPath}" Data="{StaticResource Celah.Icon.Music}"
                          Stroke="{StaticResource Celah.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Instrumental}">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                        </Path.LayoutTransform>
                    </Path>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource Celah.Text.Title}" />
                <TextBlock x:Name="EmptyBody" Style="{StaticResource Celah.Text.Body}" Margin="0,4,0,0"
                           Foreground="{StaticResource Celah.Brush.TextSecondary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter='NotFound,Failed'}">
                    <Button Style="{StaticResource PillButton}" Content="Cari lagi" Command="{Binding RetryCommand}" />
                    <Button Style="{StaticResource TextButton}" Content="Lihat di peramban" Margin="8,0,0,0"
                            Command="{Binding OpenInBrowserCommand}" />
                </StackPanel>
                <Button Style="{StaticResource PillButton}" Content="Buka pengaturan" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Command="{Binding OpenSettingsCommand}"
                        Visibility="{Binding State, Converter={StaticResource Is}, ConverterParameter=Disabled}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
