<UserControl x:Class="Celah.App.Controls.Kedip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Mata 6 × 10, radius 3, jarak 10, text-primary opacity 0.92 (Collapsed.dc.html) -->
    <StackPanel x:Name="Eyes" Orientation="Horizontal" RenderTransformOrigin="0.5,0.5" Opacity="0.92">
        <StackPanel.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="BreatheScale" />
                <TranslateTransform x:Name="LookShift" />
            </TransformGroup>
        </StackPanel.RenderTransform>
        <Rectangle x:Name="LeftEye" Width="6" Height="10" RadiusX="3" RadiusY="3"
                   Fill="{StaticResource Celah.Brush.TextPrimary}" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="LeftBlink" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="RightEye" Width="6" Height="10" RadiusX="3" RadiusY="3" Margin="10,0,0,0"
                   Fill="{StaticResource Celah.Brush.TextPrimary}" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="RightBlink" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </StackPanel>
</UserControl>
