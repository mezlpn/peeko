<!-- Modul Fokus (Focus.dc.html): progress stadium 236 × 120 di kiri, info sesi dan tombol di kanan. -->
<UserControl x:Class="Celah.App.Productivity.FocusModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,6,4,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Stadium: track + garis sisa waktu yang menyusut searah jarum jam dari puncak tengah -->
        <Grid Width="236" Height="120">
            <Path x:Name="Track" StrokeThickness="4" Stroke="{StaticResource Celah.Brush.SurfaceHover}" />
            <Path x:Name="Progress" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ModeLabel" Style="{StaticResource Celah.Text.Overline}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TimeText" Style="{StaticResource Celah.Text.TimerDisplay}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="SessionText" Style="{StaticResource Celah.Text.Overline}" Foreground="{StaticResource Celah.Brush.TextTertiary}" />
            <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="0,6,0,0" />
            <TextBlock x:Name="InfoText" Style="{StaticResource Celah.Text.Base}" FontSize="12" LineHeight="16" Margin="0,12,0,0"
                       Foreground="{StaticResource Celah.Brush.TextSecondary}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PrimaryButton" Style="{StaticResource Celah.Button.Pill}" Click="OnPrimary" />
                <Button x:Name="ResetButton" Style="{StaticResource Celah.Button.Icon}" Tag="{StaticResource Celah.Icon.Reset}"
                        ToolTip="Ulangi sesi" Margin="8,0,0,0" Click="OnReset" />
                <Button x:Name="SkipButton" Style="{StaticResource Celah.Button.Icon}" Tag="{StaticResource Celah.Icon.Skip}"
                        ToolTip="Lewati" Click="OnSkip" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
