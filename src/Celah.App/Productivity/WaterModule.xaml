<!-- Modul Minum (WaterTodo.dc.html): angka besar + delapan gelas 22 × 36, pemisah, pengingat dan tombol. -->
<UserControl x:Class="Celah.App.Productivity.WaterModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Atas: jumlah gelas atau "target tercapai" -->
        <Grid VerticalAlignment="Center">
            <StackPanel x:Name="CountView" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="CountText" Style="{StaticResource Celah.Text.TimerDisplay}" />
                <TextBlock x:Name="GoalText" Style="{StaticResource Celah.Text.Title}" Margin="6,0,0,6" VerticalAlignment="Bottom"
                           Foreground="{StaticResource Celah.Brush.TextSecondary}" />
            </StackPanel>
            <StackPanel x:Name="DoneView" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M2,10 Q8,0 14,10" Stroke="{StaticResource Celah.Brush.Water}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="12" />
                    <Path Data="M2,10 Q8,0 14,10" Stroke="{StaticResource Celah.Brush.Water}" StrokeThickness="3" Margin="6,0,0,0"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="12" />
                </StackPanel>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Style="{StaticResource Celah.Text.Title}" Text="Target hari ini tercapai" />
                    <TextBlock x:Name="DoneDetail" Style="{StaticResource Celah.Text.Body}" Foreground="{StaticResource Celah.Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="Glasses" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Celah.Brush.SurfaceHover}" />

        <!-- Bawah: pengingat dan tombol -->
        <Grid Grid.Row="2" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ReminderText" Style="{StaticResource Celah.Text.BodyStrong}" />
                <TextBlock x:Name="ReminderDetail" Style="{StaticResource Celah.Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource Celah.Button.Icon}" Tag="{StaticResource Celah.Icon.Minus}"
                        ToolTip="Kurangi satu gelas" Click="OnUndo" />
                <Button x:Name="DrinkButton" Style="{StaticResource Celah.Button.Pill}" Margin="6,0,0,0"
                        Tag="{StaticResource Celah.Fill.Plus}" Content="1 gelas" Click="OnDrink" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
