<!-- Jendela Pengaturan (Settings.dc.html): 960 × 720 (min 720 × 520), title bar kustom gelap,
     navigasi kiri sebagai anchor, semua perubahan langsung diterapkan. -->
<Window x:Class="Celah.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Celah.App.Controls"
        Title="Pengaturan Celah" Width="960" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Celah.Brush.WinBg}"
        FontFamily="{StaticResource Celah.Font}" Foreground="{StaticResource Celah.Brush.TextPrimary}"
        Icon="pack://application:,,,/Assets/celah.ico" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Celah.Text.Base}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextSecondary}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Celah.Brush.WinCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource Celah.Brush.WinStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Baris kartu: min 46 px, padding 8 14, garis pemisah di atas kecuali baris pertama -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#2C2C31" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Celah.Text.Base}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Celah.Text.Base}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="12,0">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Background="{StaticResource Celah.Brush.Accent}" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Celah.Brush.WinCardHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Celah.Brush.WinCard}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Celah.Button.Flat}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Celah.Brush.TextSecondary}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Tag" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource Celah.Brush.WinTitlebar}">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/celah.ico" Width="16" Height="16" />
                <TextBlock Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Celah.Brush.TextSecondary}"
                           Text="Pengaturan Celah" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimalkan">
                    <Path Data="M7,12 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="24" Height="24">
                        <Path.LayoutTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Path.LayoutTransform>
                    </Path>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="Tutup">
                    <Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="24" Height="24">
                        <Path.LayoutTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Path.LayoutTransform>
                    </Path>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigasi -->
            <Border BorderBrush="#26262B" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                        <Image Source="pack://application:,,,/Assets/celah.ico" Width="36" Height="36" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="20" LineHeight="26" FontWeight="SemiBold" Text="Celah" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Celah.Brush.TextTertiary}" Text="{Binding Version, StringFormat='versi {0}'}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="12,0" FontSize="11" LineHeight="15" TextWrapping="Wrap"
                               Foreground="{StaticResource Celah.Brush.TextTertiary}" Text="Pintasan: Win + Alt + C membuka notch" />
                    <StackPanel x:Name="Nav">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Tag="Umum" Content="Umum" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Modul" Content="Modul" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Baterai" Content="Baterai" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Minum" Content="Minum air" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Fokus" Content="Timer fokus" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Lirik" Content="Lirik" Checked="OnNav" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Isi -->
            <ScrollViewer x:Name="Scroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Sections" Margin="28,24,4,24" ItemWidth="{Binding ActualWidth, ElementName=ColumnProbe}">
                    <!-- Kolom kiri -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel x:Name="Umum" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="UMUM" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Mulai bersama Windows" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Berjalan diam-diam di tray" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,120,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Garis tipis" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Saat jendela aktif menempel ke tepi atas, mis. tab Chrome" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" MinWidth="110" Click="OnSlimMode"
                                                Style="{StaticResource Celah.Button.Flat}" Tag="6" BorderThickness="1">
                                            <Border CornerRadius="6" BorderBrush="{StaticResource Celah.Brush.WinStroke}" BorderThickness="1"
                                                    Background="{StaticResource Celah.Brush.WinBg}" Padding="10,0" Height="30" MinWidth="110">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" Text="{Binding SlimModeText}" />
                                                    <Path Data="M6,9.5 L12,15.5 L18,9.5" Stroke="{StaticResource Celah.Brush.TextSecondary}" StrokeThickness="2"
                                                          Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Path.LayoutTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Path.LayoutTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,140,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Geser horizontal" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Hindari webcam atau tombol jendela" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Style="{StaticResource Celah.SliderCentered}" Width="96" Minimum="-300" Maximum="300"
                                                    SmallChange="10" LargeChange="50" Value="{Binding HorizontalOffset}" />
                                            <TextBlock Width="40" Margin="8,0,0,0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Celah.Brush.TextSecondary}" Text="{Binding HorizontalOffset, StringFormat='{}{0:+0;-0;0} px'}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Sembunyikan saat layar penuh" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Game, video, presentasi" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HideOnFullscreen}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Modul" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="MODUL" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Musik" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MusicEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Lirik" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LyricsEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Timer fokus" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding FocusEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Minum air" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding WaterEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="To-do" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding TodoEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}" MinHeight="40">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Rak file" />
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ShelfEnabled}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Peek sistem" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Volume, kecerahan, Caps Lock, jaringan… Baterai kritis selalu muncul." />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SystemPeeksEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kolom kanan -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel x:Name="Baterai" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="BATERAI" />
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Margin="0,0,48,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Ingatkan saat baterai di bawah" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Peringatan kritis selalu muncul di 10%" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Celah.Brush.Accent}"
                                                   Text="{Binding BatteryThreshold, StringFormat='{}{0}%'}" />
                                    </Grid>
                                    <Slider Style="{StaticResource Celah.Slider}" Margin="0,10,0,0" Minimum="10" Maximum="50" SmallChange="5" LargeChange="5"
                                            IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding BatteryThreshold}" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource Celah.Brush.TextTertiary}" Text="10%" />
                                        <TextBlock FontSize="10" Foreground="{StaticResource Celah.Brush.TextTertiary}" HorizontalAlignment="Right" Text="50%" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Minum" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="MINUM AIR" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Ingatkan setiap" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Hanya antara 08.00 dan 21.00" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="15" Maximum="240" Step="15" Suffix="mnt"
                                                          Value="{Binding WaterIntervalMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Target harian" />
                                            <TextBlock Style="{StaticResource Hint}" Text="1 gelas = 250 ml" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="1" Maximum="20" Suffix="gelas"
                                                          Value="{Binding WaterGoal}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Fokus" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="TIMER FOKUS" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Durasi fokus" />
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="5" Maximum="120" Step="5" Suffix="mnt"
                                                          Value="{Binding FocusMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Text="Istirahat pendek" />
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="1" Maximum="30" Suffix="mnt"
                                                          Value="{Binding ShortBreakMinutes}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowLine}" />
                                    <Grid Style="{StaticResource Row}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,8,130,8">
                                            <TextBlock Style="{StaticResource Label}" Text="Istirahat panjang" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Setelah 4 sesi" />
                                        </StackPanel>
                                        <controls:Stepper HorizontalAlignment="Right" VerticalAlignment="Center" Minimum="5" Maximum="60" Step="5" Suffix="mnt"
                                                          Value="{Binding LongBreakMinutes}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="Lirik" Margin="0,0,0,22">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="LIRIK" />
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center" Margin="0,8,56,8">
                                        <TextBlock Style="{StaticResource Label}" Text="Ambil lirik dari internet" />
                                        <TextBlock Style="{StaticResource Hint}">
                                            Judul, artis, dan durasi dikirim ke
                                            <Hyperlink NavigateUri="https://lrclib.net" RequestNavigate="OnLink" Foreground="{StaticResource Celah.Brush.Accent}">lrclib.net</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Celah.Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding FetchLyrics}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>
            <!-- Lebar satu kolom: dua kolom bila cukup lebar, satu kolom bila jendela sempit -->
            <Border x:Name="ColumnProbe" Grid.Column="1" Visibility="Hidden" HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</Window>
