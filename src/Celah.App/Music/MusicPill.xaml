<!-- Pil musik 260 × 32 (Collapsed.dc.html): cover 20 px (r 6) di kiri 6 px, empat bar 3 px di kanan 12 px. -->
<UserControl x:Class="Celah.App.Music.MusicPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" IsHitTestVisible="False">
    <UserControl.Resources>
        <Style x:Key="Bar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{Binding AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource Celah.Brush.TextTertiary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CoverBox" Width="20" Height="20" Margin="6,0,0,0" HorizontalAlignment="Left"
                CornerRadius="{StaticResource Celah.Radius.Sm}" Background="{StaticResource Celah.Brush.SurfaceRaised}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border CornerRadius="{StaticResource Celah.Radius.Sm}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <Rectangle x:Name="Bar0" Style="{StaticResource Bar}" Margin="0" />
            <Rectangle x:Name="Bar1" Style="{StaticResource Bar}" />
            <Rectangle x:Name="Bar2" Style="{StaticResource Bar}" />
            <Rectangle x:Name="Bar3" Style="{StaticResource Bar}" />
        </StackPanel>
    </Grid>
</UserControl>
